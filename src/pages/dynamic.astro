---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MainText from '../components/MainText.astro';
import DynamicCard from '../components/DynamicCard.astro';

// 获取所有动态，按 pubDate 降序（最新的在前）
const allDynamics: CollectionEntry<'dynamics'>[] = await getCollection('dynamics');
const sortedDynamics = allDynamics.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout pageTitle="动态">
  <MainText>
    <span style="margin-bottom: 1rem; margin-left: 1rem;">可以通过<a style="color: #353535;" href="https://yirween.com/rss-dynamic.xml" target="_blank" rel="noreferrer">https://yirween.com/rss-dynamic.xml</a>订阅yirween的动态喵</span>
    {
      sortedDynamics.map((entry) => {
        const date = entry.data.pubDate;
        const dynamicTime = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')} ${String(date.getHours()).padStart(2, '0')}:${String(date.getMinutes()).padStart(2, '0')}`;
        return (
          <DynamicCard
            dynamicTime={dynamicTime}
            tags={entry.data.tags}
          >
            <span set:html={entry.body} /> {/* 或者使用 <> 但 set:html 需要包裹元素 */}
          </DynamicCard>
        );
      })
    }
  </MainText>
  <dialog class="image-viewer" aria-label="图片预览">
    <button class="image-viewer-close" type="button" aria-label="关闭图片预览">×</button>
    <div class="image-viewer-stage">
      <img alt="" draggable="false" />
    </div>
  </dialog>
</BaseLayout>

<script>
  const initImageGalleries = () => {
    document.querySelectorAll<HTMLElement>('.dynamicCard-text').forEach((content) => {
      if (content.querySelector('.dynamic-image-gallery')) return;

      const images = [...content.querySelectorAll<HTMLImageElement>('img')];
      if (images.length === 0) return;

      const gallery = document.createElement('div');
      gallery.className = 'dynamic-image-gallery';
      gallery.setAttribute('aria-label', '动态图片');
      gallery.addEventListener('click', (event) => event.stopPropagation());

      images.forEach((image) => {
        image.draggable = false;
        gallery.append(image);
      });
      content.append(gallery);
    });
  };

  const initImageViewer = () => {
    const viewer = document.querySelector<HTMLDialogElement>('.image-viewer');
    const viewerImage = viewer?.querySelector<HTMLImageElement>('img');
    const closeButton = viewer?.querySelector<HTMLButtonElement>('.image-viewer-close');
    const stage = viewer?.querySelector<HTMLElement>('.image-viewer-stage');
    if (!viewer || !viewerImage || !closeButton || !stage || viewer.dataset.initialized === 'true') return;

    viewer.dataset.initialized = 'true';
    let scale = 1;
    let offsetX = 0;
    let offsetY = 0;
    let pointerId: number | null = null;
    let startX = 0;
    let startY = 0;

    const updateImageTransform = () => {
      viewerImage.style.transform = `translate(${offsetX}px, ${offsetY}px) scale(${scale})`;
    };

    const resetImageTransform = () => {
      scale = 1;
      offsetX = 0;
      offsetY = 0;
      viewerImage.style.transform = '';
    };

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLImageElement) || !target.closest('.dynamicCard')) return;

      viewerImage.src = target.currentSrc || target.src;
      viewerImage.alt = target.alt || '动态图片预览';
      resetImageTransform();
      viewer.showModal();
    });

    closeButton.addEventListener('click', () => viewer.close());
    viewerImage.addEventListener('dragstart', (event) => event.preventDefault());
    viewer.addEventListener('wheel', (event) => {
      if (event.target !== viewerImage) return;
      event.preventDefault();
      scale = Math.min(20, Math.max(0.5, scale * (event.deltaY < 0 ? 1.1 : 0.9)));
      updateImageTransform();
    }, { passive: false });

    viewerImage.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      pointerId = event.pointerId;
      startX = event.clientX - offsetX;
      startY = event.clientY - offsetY;
      viewerImage.setPointerCapture(pointerId);
      viewerImage.classList.add('is-dragging');
    });

    viewerImage.addEventListener('pointermove', (event) => {
      if (event.pointerId !== pointerId) return;
      offsetX = event.clientX - startX;
      offsetY = event.clientY - startY;
      updateImageTransform();
    });

    const stopDragging = (event: PointerEvent) => {
      if (event.pointerId !== pointerId) return;
      pointerId = null;
      viewerImage.classList.remove('is-dragging');
    };

    viewerImage.addEventListener('pointerup', stopDragging);
    viewerImage.addEventListener('pointercancel', stopDragging);
    viewer.addEventListener('click', (event) => {
      if (event.target === viewer || event.target === stage) viewer.close();
    });
  };

  const initDynamicImages = () => {
    initImageGalleries();
    initImageViewer();
  };

  document.addEventListener('DOMContentLoaded', initDynamicImages);
  document.addEventListener('astro:page-load', initDynamicImages);
</script>