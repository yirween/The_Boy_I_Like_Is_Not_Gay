---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DynamicCard from '../../components/DynamicCard.astro';

export async function getStaticPaths() {
  const dynamics: CollectionEntry<'dynamics'>[] = await getCollection('dynamics');

  return dynamics.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'dynamics'>;
}

const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const date = entry.data.pubDate;
const dynamicTime = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')} ${String(date.getHours()).padStart(2, '0')}:${String(date.getMinutes()).padStart(2, '0')}`;
---

<BaseLayout pageTitle={entry.data.title}>
  <DynamicCard dynamicTime={dynamicTime} tags={entry.data.tags}>
    <Content />
  </DynamicCard>
</BaseLayout>
