---
import BaseLayout from '../layouts/BaseLayout.astro';
import Line from '../components/Line.astro';
import MainText from '../components/MainText.astro'
import CommentDew from '../components/CommentDew.astro';
import "../styles/about.css";
---

<BaseLayout pageTitle = "About">
    <MainText>
      <div class="head slide-in-1">
        <!-- 第一行 -->
        <div class="head-card hello-card">
          <span class="hello-text">你好，我是<ruby><rb>Yirween</rb><rt>/ ˈ ɪ ( r ) . w i ː n /</rt></ruby></span>
        </div>
        <div class="head-card headimg-card">
          <img src="/ynhdimgRD.png" alt="这里是Yirween的头像，但是它不见了">
        </div>
      </div>

      <span class="mobile-warning">本站还没有适配移动端，所以在手机上可能会有一些显示问题，建议在电脑上访问喵~</span><br />

      <!-- 第二行 -->
      <div class="details slide-in-2">
        <div class="introductionAndCalendar">
          <div class="head-card introduction">
            <div class="content-title">▌自我介绍</div>
            <div class="self-introduction">来自中国的魔女，对一切保持好奇~</div>
          </div>
          <!-- 第三行 -->
          <div class="head-card date-all slide-in-3">
            <div class="calendar">
              <div class="calendar-head">

                <div class="calendar-choosemonth">
                  <div class="calendar-turnleft"></div>
                  <div class="calendar-year">加载中</div>
                  <div class="calendar-month">...</div>
                  <div class="calendar-turnright"></div>
                </div>

                <div class="calendar-week">
                  <div class="calendar-weekday">日</div>
                  <div class="calendar-weekday">一</div>
                  <div class="calendar-weekday">二</div>
                  <div class="calendar-weekday">三</div>
                  <div class="calendar-weekday">四</div>
                  <div class="calendar-weekday">五</div>
                  <div class="calendar-weekday">六</div>
                </div>
              </div>

              <div class="calendar-body">
              </div>
            </div>

            <div class="day-events">
              这里是日历，还没做完喵
            </div>
          </div>
        </div>

        <div class="head-card content-card slide-in-4">
          <div class="content-title">▌联系方式</div>
          <div class="content-list">
            <!-- 阿B -->
            <a class="content slide-in-5" href="https://message.bilibili.com/?spm_id_from=333.1387.0.0#/whisper/mid648129231" target="_blank">
