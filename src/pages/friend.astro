---
import BaseLayout from '../layouts/BaseLayout.astro';
import Line from '../components/Line.astro';
import MainText from '../components/MainText.astro';
import LinkCard from '../components/LinkCard.astro';
---
<style>
    .friend-list {
        width: 100%;
        padding: 5vh 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
    }
</style>
<BaseLayout pageTitle = "Friend">
    <div class="friend-list">
        <LinkCard
            headimg="https://renly.cn/avatar.webp"
            name="EveSunMaple"
            discribe=""
            href="https://renly.cn"
        ></LinkCard>
        <LinkCard
            headimg="https://siquan001.github.io/favicon.ico"
            name="雨竹upon"
            discribe="海内存知己，天涯若比邻。"
            href="https://siquan001.github.io/"
        ></LinkCard>
    </div>
</BaseLayout>