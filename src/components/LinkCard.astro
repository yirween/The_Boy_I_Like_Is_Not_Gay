---
const props = Astro.props as {
    headimg: string;
    name: string;
    discribe: string;
    href: string;
};
---

<a class="linkCard" href={props.href} target="_blank">
    <div class="linkCard-headimg">
        <img src={props.headimg} alt="">
    </div>
    <div class="linkCard-rightText">
        <div class="linkCard-rightText-name">{props.name}</div>
        <div class="linkCard-rightText-discribe">{props.discribe}</div>
    </div>
</a>