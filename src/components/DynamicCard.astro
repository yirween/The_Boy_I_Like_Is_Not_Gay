---
interface Props {
    dynamicTime: string;
    tags: string[];
}

const { dynamicTime, tags } = Astro.props as Props;
---


<div class="dynamicCard">
    <div class="dynamicCard-time">{dynamicTime}</div>

    <div class="dynamicCard-text">
        <slot />
    </div>

    {tags.map(tag => (
        <span class="dynamicCard-tag">{tag}</span>
    ))}

</div>
