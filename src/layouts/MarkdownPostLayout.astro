---
import BaseLayout from '../layouts/BaseLayout.astro';
import Line from '../components/Line.astro';
import MainText from '../components/MainText.astro';
const raw = Astro.url?.pathname?.split('/').pop();
const postName = raw ? decodeURIComponent(raw) : '';
---

<BaseLayout pageTitle = {postName}>
    <MainText>
        <slot />
    </MainText>
</BaseLayout>
